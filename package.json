{
  "name": "zou",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/setup-db.mjs && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/migrate.mjs",
    "db:ingest": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/ingest.mjs",
    "db:setup": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/setup-db.mjs",
    "db:sql": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/emit-sql.ts",
    "pack:app": "node scripts/pack-app.mjs",
    "test": "node --import ./tests/register.mjs tests/unit.mjs && node --import ./tests/register.mjs tests/e2e.mjs && node --import ./tests/register.mjs tests/e2e.mjs --blob-oidc",
    "serve:local": "node --import ./tests/register.mjs tests/server.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@vercel/blob": "^2.8.0",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.6"
  },
  "type": "module"
}
