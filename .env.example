# Base Neon (chaîne « pooled » du tableau de bord Neon)
DATABASE_URL=postgres://user:password@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
# Au moins 32 caractères aléatoires : openssl rand -base64 48
AUTH_SECRET=
# Clé de l'API Claude (assistant)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Fichiers du coffre : magasin Vercel Blob en accès privé (renseigné par Vercel en reliant le magasin)
BLOB_READ_WRITE_TOKEN=
# Envoi d'e-mails (codes de connexion, rappels, contact) : https://resend.com
RESEND_API_KEY=
MAIL_FROM="ZOU <contact@votre-domaine>"
SUPPORT_EMAIL=
# Jetons d'administration et de tâche planifiée (au moins 24 / 16 caractères)
ADMIN_TOKEN=
CRON_SECRET=
# Développement uniquement : renvoie le code de connexion dans la réponse
AUTH_DEV_ECHO=0
# Préparation de la base au déploiement : auto (production seulement), always, off
ZOU_DB_SETUP=auto
